{
  "name": "racristyle",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma SaaS de reservas para barberías, salones y spas",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "demo": "node scripts/demo.js",
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write \"{src,public,scripts,test}/**/*.{js,css,html}\" \"*.{js,json,md,yaml}\"",
    "format:check": "prettier --check \"{src,public,scripts,test}/**/*.{js,css,html}\" \"*.{js,json,md,yaml}\"",
    "quality": "npm run lint && npm run format:check && npm test",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "test:technical": "node --test test/technical-quality.test.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^16.5.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
