PORT=3000
TZ=America/Costa_Rica
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/racristyle
DATABASE_SSL=false
# Docker Compose usa internamente db:5432 y expone PostgreSQL en localhost:5433.
POSTGRES_PASSWORD=postgres
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres
NODE_ENV=development
APP_URL=http://localhost:3000
BOOKING_CONFIRMATION_MINUTES=15

# En desarrollo puede usar "json". Para correos reales cambie a "smtp".
MAIL_MODE=json
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=contraseña-de-aplicacion
MAIL_FROM=RaCristyle <tu-correo@gmail.com>
